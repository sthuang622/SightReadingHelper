<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SightReadingHelper.MainPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Home">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,30"
                             Spacing="16">
            <Border Stroke="{StaticResource AccentBrush}"
                    StrokeThickness="0"
                    Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="{StaticResource PrimaryDarkText}"
                                      Offset="0" />
                        <GradientStop Color="{StaticResource Primary}"
                                      Offset="0.65" />
                        <GradientStop Color="{StaticResource Accent}"
                                      Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Grid x:Name="HeroGrid"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="14"
                      RowSpacing="10">
                    <Label Grid.Row="0"
                           Grid.Column="0"
                           x:Name="HeroTitleLabel"
                           Text="Sight Reading Helper"
                           FontSize="36"
                           FontFamily="OpenSansSemibold"
                           LineBreakMode="WordWrap"
                           TextColor="{StaticResource White}" />
                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Padding="12,7"
                            VerticalOptions="Start"
                            Background="{StaticResource SecondaryBrush}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Label Text="LIVE MIC"
                               FontSize="11"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource PrimaryDarkText}" />
                    </Border>

                    <Label Grid.Row="1"
                           Grid.ColumnSpan="2"
                           x:Name="SelectedInstrumentLabel"
                           FontSize="24"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource Secondary}" />
                    <Label Grid.Row="2"
                           Grid.ColumnSpan="2"
                           x:Name="InstrumentSummaryLabel"
                           FontSize="15"
                           LineHeight="1.25"
                           TextColor="{StaticResource White}" />
                </Grid>
            </Border>

            <Grid x:Name="HomeActionGrid"
                  ColumnDefinitions="*,150,54"
                  RowDefinitions="Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">
                <Border Grid.Column="0"
                        x:Name="StartPracticeButton"
                        BackgroundColor="{StaticResource Primary}"
                        StrokeThickness="0"
                        MinimumHeightRequest="52">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,56">
                        <Grid Grid.Column="0"
                              Padding="18,15">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnStartPracticeTapped" />
                            </Grid.GestureRecognizers>
                            <Label x:Name="PracticeButtonLabel"
                                   Text="Practice"
                                   TextColor="{StaticResource White}"
                                   FontSize="17"
                                   FontFamily="OpenSansSemibold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation" />
                        </Grid>
                        <Grid Grid.Column="1"
                              x:Name="PracticeModeDropDownArea"
                              BackgroundColor="#174638">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPracticeModeTapped" />
                            </Grid.GestureRecognizers>
                            <Label Text="▼"
                                   TextColor="{StaticResource White}"
                                   FontSize="13"
                                   FontFamily="OpenSansSemibold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </Border>
                <Button Grid.Column="1"
                        x:Name="CalibrateButton"
                        Text="Calibrate"
                        Style="{StaticResource SecondaryButtonStyle}"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="{StaticResource PrimaryDarkText}"
                        FontSize="17"
                        FontFamily="OpenSansSemibold"
                        Padding="18,15"
                        Clicked="OnOpenCalibrationClicked" />
                <Button Grid.Column="2"
                        x:Name="SettingsButton"
                        Text="⚙"
                        Style="{StaticResource SecondaryButtonStyle}"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="{StaticResource PrimaryDarkText}"
                        FontSize="21"
                        FontFamily="OpenSansSemibold"
                        Padding="0"
                        Clicked="OnOpenSettingsClicked" />
            </Grid>

            <Grid x:Name="HomeOptionsGrid"
                  ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">
                <Border Grid.Row="0"
                        Grid.Column="0"
                        x:Name="ClefCard"
                        Background="{StaticResource HomeCardSurfaceBrush}"
                        Style="{StaticResource StatusCardStyle}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Clef"
                               Style="{StaticResource EyebrowStyle}" />
                        <Label x:Name="ClefValueLabel"
                               Style="{StaticResource StatValueStyle}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="1"
                        x:Name="RangeCard"
                        Background="{StaticResource HomeCardSurfaceBrush}"
                        Style="{StaticResource StatusCardStyle}">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0"
                                             Spacing="6"
                                             VerticalOptions="Center">
                            <Label Text="Range"
                                   Style="{StaticResource EyebrowStyle}" />
                            <Label Text="Use bigger range"
                                   Style="{StaticResource StatValueStyle}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                x:Name="HomeBiggerRangeSwitch"
                                VerticalOptions="Center"
                                Toggled="OnHomeOptionToggled" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="0"
                        x:Name="InstrumentTypeCard"
                        Background="{StaticResource HomeCardSurfaceBrush}"
                        Style="{StaticResource StatusCardStyle}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Instrument type"
                               Style="{StaticResource EyebrowStyle}" />
                        <Picker x:Name="HomeInstrumentTypePicker"
                                FontSize="18"
                                FontFamily="OpenSansSemibold"
                                SelectedIndexChanged="OnHomeInstrumentTypeChanged" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="1"
                        x:Name="InstrumentCard"
                        Background="{StaticResource HomeCardSurfaceBrush}"
                        Style="{StaticResource StatusCardStyle}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Instrument"
                               Style="{StaticResource EyebrowStyle}" />
                        <Picker x:Name="HomeInstrumentPicker"
                                FontSize="18"
                                FontFamily="OpenSansSemibold"
                                SelectedIndexChanged="OnHomeOptionChanged" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2"
                        Grid.Column="0"
                        x:Name="NoteMovementCard"
                        Background="{StaticResource HomeCardSurfaceBrush}"
                        Style="{StaticResource StatusCardStyle}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Note movement"
                               Style="{StaticResource EyebrowStyle}" />
                        <Picker x:Name="HomeMaxJumpPicker"
                                FontSize="18"
                                FontFamily="OpenSansSemibold"
                                SelectedIndexChanged="OnHomeOptionChanged" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2"
                        Grid.Column="1"
                        x:Name="TempoCard"
                        Background="{StaticResource HomeCardSurfaceBrush}"
                        Style="{StaticResource StatusCardStyle}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Tempo"
                               Style="{StaticResource EyebrowStyle}" />
                        <Picker x:Name="HomeBeatTempoPicker"
                                FontSize="18"
                                FontFamily="OpenSansSemibold"
                                SelectedIndexChanged="OnHomeOptionChanged" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
