<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SightReadingHelper.MainPage"
             Title="Home">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,30"
                             Spacing="16">
            <Border Stroke="{StaticResource AccentBrush}"
                    StrokeThickness="0"
                    Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="{StaticResource PrimaryDarkText}"
                                      Offset="0" />
                        <GradientStop Color="{StaticResource Primary}"
                                      Offset="0.65" />
                        <GradientStop Color="{StaticResource Accent}"
                                      Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="14"
                      RowSpacing="10">
                    <Label Grid.Row="0"
                           Grid.Column="0"
                           Text="Sight Reading Helper"
                           FontSize="36"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource White}" />
                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Padding="12,7"
                            VerticalOptions="Start"
                            Background="{StaticResource SecondaryBrush}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Label Text="LIVE MIC"
                               FontSize="11"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource PrimaryDarkText}" />
                    </Border>

                    <Label Grid.Row="1"
                           Grid.ColumnSpan="2"
                           x:Name="SelectedInstrumentLabel"
                           FontSize="24"
                           FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource Secondary}" />
                    <Label Grid.Row="2"
                           Grid.ColumnSpan="2"
                           x:Name="InstrumentSummaryLabel"
                           FontSize="15"
                           LineHeight="1.25"
                           TextColor="{StaticResource White}" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12"
                  RowSpacing="12">
                <Button Grid.Column="0"
                        Text="Start Practice"
                        FontSize="17"
                        FontFamily="OpenSansSemibold"
                        Padding="18,15"
                        Clicked="OnOpenPracticeClicked" />
                <Button Grid.Column="1"
                        Text="Calibrate"
                        Style="{StaticResource SecondaryButtonStyle}"
                        FontSize="17"
                        FontFamily="OpenSansSemibold"
                        Padding="18,15"
                        Clicked="OnOpenCalibrationClicked" />
            </Grid>

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">
                <Border Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource StatusCardStyle}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Clef"
                               Style="{StaticResource EyebrowStyle}" />
                        <Label x:Name="ClefValueLabel"
                               Style="{StaticResource StatValueStyle}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource StatusCardStyle}">
                    <VerticalStackLayout Spacing="3">
                        <Picker x:Name="HomeInstrumentPicker"
                                Title="Instrument"
                                SelectedIndexChanged="OnHomeOptionChanged" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource PanelCardStyle}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0"
                                             Spacing="3">
                            <Label Text="Quick Setup"
                                   Style="{StaticResource SectionTitleStyle}" />
                            <Label Text="Tune the session before jumping in."
                                   Style="{StaticResource BodyMutedStyle}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                Style="{StaticResource StatusCardStyle}"
                                Padding="12,8">
                            <Grid ColumnDefinitions="Auto,Auto"
                                  ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Use bigger range"
                                       Style="{StaticResource BodyTextStyle}"
                                       VerticalOptions="Center" />
                                <Switch Grid.Column="1"
                                        x:Name="HomeBiggerRangeSwitch"
                                        Toggled="OnHomeOptionToggled" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto"
                          ColumnSpacing="12"
                          RowSpacing="12">
                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource StatusCardStyle}">
                            <VerticalStackLayout Spacing="3">
                                <Picker x:Name="HomeMaxJumpPicker"
                                        Title="Tuning note movement"
                                        SelectedIndexChanged="OnHomeOptionChanged" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource StatusCardStyle}">
                            <VerticalStackLayout Spacing="3">
                                <Picker x:Name="HomeBeatTempoPicker"
                                        Title="Tempo"
                                        SelectedIndexChanged="OnHomeOptionChanged" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
