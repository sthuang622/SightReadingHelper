<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SightReadingHelper.MainPage"
             Title="Home">
    <ScrollView>
        <VerticalStackLayout Padding="24,20,24,32"
                             Spacing="20">
            <Border Background="{StaticResource SurfaceBrush}"
                    Stroke="{StaticResource AccentBrush}"
                    StrokeThickness="2"
                    Padding="24">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Sight Reading Helper"
                           Style="{StaticResource HeroTitleStyle}" />
                    <Label x:Name="SelectedInstrumentLabel"
                           Style="{StaticResource SectionTitleStyle}" />
                    <Label x:Name="InstrumentSummaryLabel"
                           Style="{StaticResource BodyMutedStyle}" />
                    <Label x:Name="SettingsSummaryLabel"
                           Style="{StaticResource BodyTextStyle}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">
                <Border Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource StatusCardStyle}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Clef"
                               Style="{StaticResource EyebrowStyle}" />
                        <Label x:Name="ClefValueLabel"
                               Style="{StaticResource StatValueStyle}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource StatusCardStyle}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Exercise Range"
                               Style="{StaticResource EyebrowStyle}" />
                        <Label x:Name="RangeValueLabel"
                               Style="{StaticResource StatValueStyle}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource StatusCardStyle}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Base Notes"
                               Style="{StaticResource EyebrowStyle}" />
                        <Label x:Name="BaseNotesValueLabel"
                               Style="{StaticResource StatValueStyle}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource StatusCardStyle}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Calibration"
                               Style="{StaticResource EyebrowStyle}" />
                        <Label x:Name="CalibrationStatusLabel"
                               Style="{StaticResource StatValueStyle}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Style="{StaticResource PanelCardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="MVP Flow"
                           Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="Choose an instrument, save calibration notes, generate an exercise, enter the detected pitch, and advance when the note is correct."
                           Style="{StaticResource BodyTextStyle}" />
                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Start Practice"
                                Clicked="OnOpenPracticeClicked" />
                        <Button Text="Calibration"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Clicked="OnOpenCalibrationClicked" />
                        <Button Text="Settings"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Clicked="OnOpenSettingsClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
