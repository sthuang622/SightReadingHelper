<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SightReadingHelper.PracticePage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Practice">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,30"
                             Spacing="16">
            <Border Padding="22,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource PrimaryDarkText}" Offset="0" />
                        <GradientStop Color="{StaticResource Primary}" Offset="0.7" />
                        <GradientStop Color="{StaticResource Accent}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Practice"
                               FontSize="30"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource White}" />
                        <Label Text="Play through an endless stream of notes"
                               Style="{StaticResource BodyMutedStyle}"
                               TextColor="{StaticResource White}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Home"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Clicked="OnHomeClicked" />
                </Grid>
            </Border>

            <Border Style="{StaticResource PanelCardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Practice Session"
                           Style="{StaticResource SectionTitleStyle}" />
                    <Label x:Name="PracticeSummaryLabel"
                           Style="{StaticResource BodyTextStyle}" />
                    <Label x:Name="PracticeSettingsLabel"
                           Style="{StaticResource BodyMutedStyle}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource PanelCardStyle}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Endless Practice"
                           Style="{StaticResource SectionTitleStyle}" />
                    <ProgressBar x:Name="ExerciseProgressBar"
                                 Progress="0" />
                    <Label x:Name="ProgressLabel"
                           Style="{StaticResource BodyMutedStyle}" />
                    <ScrollView Orientation="Horizontal">
                        <GraphicsView x:Name="NotationView"
                                      HeightRequest="250"
                                      WidthRequest="720" />
                    </ScrollView>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource PanelCardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Current Pitch Target"
                           Style="{StaticResource SectionTitleStyle}" />
                    <Label x:Name="ExpectedPitchLabel"
                           Style="{StaticResource BodyTextStyle}" />
                    <Label x:Name="DetectedPitchSummaryLabel"
                           Style="{StaticResource BodyMutedStyle}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource PanelCardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Microphone"
                           Style="{StaticResource SectionTitleStyle}" />
                    <ProgressBar x:Name="MicrophoneLevelBar"
                                 Progress="0" />
                    <Label x:Name="MicrophoneStatusLabel"
                           Style="{StaticResource BodyMutedStyle}" />
                    <Label x:Name="JudgmentLabel"
                           Style="{StaticResource BodyTextStyle}" />
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Spacing="10">
                <Button Text="New Session"
                        Clicked="OnGenerateExerciseClicked" />
                <Button Text="Restart"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Clicked="OnRestartExerciseClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
