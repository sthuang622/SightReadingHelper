<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SightReadingHelper.SettingsPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Settings">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,30"
                             Spacing="16">
            <Border Padding="22,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource PrimaryDarkText}" Offset="0" />
                        <GradientStop Color="{StaticResource Primary}" Offset="0.7" />
                        <GradientStop Color="{StaticResource Accent}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Grid x:Name="SettingsHeaderGrid"
                      ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Settings"
                               x:Name="SettingsTitleLabel"
                               FontSize="30"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource White}" />
                        <Label Text="Shape each practice session around your goals"
                               Style="{StaticResource BodyMutedStyle}"
                               TextColor="{StaticResource White}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Home"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Clicked="OnHomeClicked" />
                </Grid>
            </Border>

            <Border Style="{StaticResource PanelCardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Instrument"
                           Style="{StaticResource SectionTitleStyle}" />
                    <Picker x:Name="InstrumentPicker"
                            SelectedIndexChanged="OnInstrumentSelectionChanged"
                            Title="Select instrument" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource PanelCardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Practice Defaults"
                           Style="{StaticResource SectionTitleStyle}" />
                    <Picker x:Name="ExerciseLengthPicker"
                            Title="Exercise length" />
                    <Picker x:Name="TolerancePicker"
                            Title="Pitch tolerance" />
                    <Picker x:Name="BeatTempoPicker"
                            Title="Hold tempo" />
                    <Picker x:Name="MaxBaseNoteJumpPicker"
                            Title="Maximum string jump" />
                    <Label x:Name="AllowedBaseNotesLabel"
                           Text="Allowed tuning notes"
                           Style="{StaticResource EyebrowStyle}" />
                    <VerticalStackLayout x:Name="BaseNoteOptionsLayout"
                                         Spacing="8" />
                    <Grid ColumnDefinitions="*,Auto"
                          RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="12">
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="Use beginner range"
                               Style="{StaticResource BodyTextStyle}" />
                        <Switch Grid.Row="0"
                                Grid.Column="1"
                                x:Name="BeginnerRangeSwitch" />

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Text="Show note names during practice"
                               Style="{StaticResource BodyTextStyle}" />
                        <Switch Grid.Row="1"
                                Grid.Column="1"
                                x:Name="ShowNoteNameSwitch" />

                        <Label Grid.Row="2"
                               Grid.Column="0"
                               Text="Include sharps"
                               Style="{StaticResource BodyTextStyle}" />
                        <Switch Grid.Row="2"
                                Grid.Column="1"
                                x:Name="AllowSharpsSwitch" />
                    </Grid>
                    <Button Text="Save Settings"
                            Clicked="OnSaveSettingsClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
