<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SightReadingHelper.Models"
             x:Class="SightReadingHelper.CalibrationPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="Calibration">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,30"
                             Spacing="16">
            <Border Padding="22,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource PrimaryDarkText}" Offset="0" />
                        <GradientStop Color="{StaticResource Primary}" Offset="0.7" />
                        <GradientStop Color="{StaticResource Accent}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Calibration"
                               FontSize="30"
                               FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource White}" />
                        <Label Text="Tune the app to your instrument and room"
                               Style="{StaticResource BodyMutedStyle}"
                               TextColor="{StaticResource White}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Home"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Clicked="OnHomeClicked" />
                </Grid>
            </Border>

            <Border Style="{StaticResource PanelCardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="CalibrationHeaderLabel"
                           Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="Play each highlighted tuning note for 1 second. The app saves each captured pitch for practice."
                           Style="{StaticResource BodyMutedStyle}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource PanelCardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Current Reference"
                           Style="{StaticResource SectionTitleStyle}" />
                    <ScrollView Orientation="Horizontal">
                        <GraphicsView x:Name="CalibrationNotationView"
                                      HeightRequest="220" />
                    </ScrollView>
                    <Label x:Name="CurrentExpectedPitchLabel"
                           Style="{StaticResource BodyTextStyle}" />
                    <ProgressBar x:Name="CalibrationMicrophoneLevelBar"
                                 Progress="0" />
                    <Label x:Name="CalibrationMicrophoneStatusLabel"
                           Style="{StaticResource BodyMutedStyle}" />
                    <HorizontalStackLayout Spacing="10">
                        <Button x:Name="StartCalibrationButton"
                                Text="Start Listening"
                                Clicked="OnStartCalibrationClicked" />
                        <Button x:Name="StopCalibrationButton"
                                Text="Stop"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="False"
                                Clicked="OnStopCalibrationClicked" />
                        <Button Text="Next"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Clicked="OnNextCalibrationNoteClicked" />
                        <Button Text="Default"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Clicked="OnUseDefaultCalibrationClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <CollectionView x:Name="CalibrationCollectionView"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CalibrationEntryViewModel">
                        <Border Style="{StaticResource PanelCardStyle}"
                                Margin="0,0,0,12">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{Binding ReferenceDisplay}"
                                       Style="{StaticResource SectionTitleStyle}" />
                                <Label Text="{Binding ResultDisplay}"
                                       Style="{StaticResource BodyTextStyle}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <HorizontalStackLayout Spacing="10">
                <Button Text="Save Calibration"
                        Clicked="OnSaveCalibrationClicked" />
                <Button Text="Use Defaults"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Clicked="OnUseDefaultCalibrationClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
